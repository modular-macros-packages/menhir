regrangeE:
  
    {( EMPTY )}
| _1 = Anyrange
    {( _1 )}

Anyrange:
  _1 = LBRACK _2 = constExpr _3 = COLON _4 = constExpr _5 = RBRACK
    {( RANGE( _2, _4) )}

delayrange:
  _1 = regrangeE _2 = delayE
    {( TRIPLE (EMPTY, _1, _2 ) )}
| _1 = SCALARED _2 = regrangeE _3 = delayE
    {( TRIPLE (SCALARED, _2, _3 ) )}
| _1 = VECTORED _2 = regrangeE _3 = delayE
    {( TRIPLE (VECTORED, _2, _3 ) )}

PortRangeE:
  
    {( SCALAR )}
| _1 = LBRACK _2 = constExpr _3 = RBRACK
    {( RANGE (_2, _2) )}
| _1 = LBRACK _2 = constExpr _3 = COLON _4 = constExpr _5 = RBRACK
    {( RANGE (_2, _4) )}

param:
