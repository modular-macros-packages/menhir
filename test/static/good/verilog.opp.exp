| _1 = D_MONITOR _2 = LPAREN _3 = monList _4 = RPAREN _5 = SEMICOLON
    {( DOUBLE (D_MONITOR, TLIST _3); )}
| _1 = REPEAT _2 = LPAREN _3 = expr _4 = RPAREN _5 = stmtBlock
    {( TRIPLE ( REPEAT, _3, _5 ) )}
| _1 = FOREVER _2 = stmtBlock
    {( DOUBLE ( FOREVER, _2 ) )}
| _1 = preproc
    {( (* Printf.fprintf Pervasives.stderr "%s\n" $1 *) _1 )}

stateCaseForIf:
  _1 = case _2 = LPAREN _3 = expr _4 = RPAREN _5 = caseAttrE _6 = caseListE _7 = ENDCASE
    {( QUADRUPLE (_1, _3, _5, _6) )}
| _1 = IF _2 = LPAREN _3 = expr _4 = RPAREN _5 = stmtBlock %prec prLOWER_THAN_ELSE
    {( TRIPLE (IF, _3, _5 ) )}
| _1 = IF _2 = LPAREN _3 = expr _4 = RPAREN _5 = stmtBlock _6 = ELSE _7 = stmtBlock
    {( QUADRUPLE (IF, _3, _5, _7 ) )}
| _1 = FOR _2 = LPAREN _3 = varRefBase _4 = EQUALS _5 = expr _6 = SEMICOLON _7 = expr _8 = SEMICOLON _9 = varRefBase _10 = EQUALS _11 = expr _12 = RPAREN _13 = stmtBlock
    {( QUINTUPLE (FOR, TRIPLE (ASSIGNMENT, _3, _5), _7, TRIPLE (ASSIGNMENT, _9, _11), _13 ) )}
| _1 = WHILE _2 = LPAREN _3 = expr _4 = RPAREN _5 = stmtBlock
    {( TRIPLE (WHILE, _3, _5 ) )}
| _1 = DO _2 = stmtBlock _3 = WHILE _4 = LPAREN _5 = expr _6 = RPAREN
    {( TRIPLE (DO, _2, _5 ) )}

case:
  _1 = CASE
    {( CASE )}
| _1 = CASEX
    {( CASEX )}
| _1 = CASEZ
    {( CASEZ )}

caseAttrE:
  
    {( EMPTY )}

caseListE:
  
    {( EMPTY )}
| _1 = caseList
    {( TLIST _1 )}

caseList:
  _1 = caseCondList _2 = COLON _3 = stmtBlock
