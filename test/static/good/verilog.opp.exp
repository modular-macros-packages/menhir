| _1 = expr _2 = P_ANDAND _3 = expr
    {( TRIPLE ( P_ANDAND, _1, _3 ) )}
| _1 = expr _2 = AMPERSAND _3 = expr
    {( TRIPLE ( AMPERSAND, _1, _3 ) )}
