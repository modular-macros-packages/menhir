| 
    {( EMPTY )}

lifetimeE:
  
    {( EMPTY )}
| _1 = STATIC
    {( STATIC )}
| _1 = AUTOMATIC
    {( AUTOMATIC )}

funcArgs:
  _1 = LPAREN _2 = PortV2kArgs _3 = RPAREN
    {( TLIST _2 )}
| 
    {( EMPTY )}

taskArgs:
  _1 = LPAREN _2 = PortV2kArgs _3 = RPAREN
    {( TLIST _2 )}
| 
    {( EMPTY )}

funcTypeE:
  
    {( SCALAR )}
| _1 = REAL
    {( REAL )}
| _1 = INTEGER
    {( INTEGER )}
| _1 = LBRACK _2 = constExpr _3 = COLON _4 = constExpr _5 = RBRACK
