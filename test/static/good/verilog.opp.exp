| _1 = IF _2 = LPAREN _3 = expr _4 = RPAREN _5 = genItemBlock _6 = ELSE _7 = genItemBlock
    {( QUADRUPLE (IF, _3, _5, _7) )}
| _1 = FOR _2 = LPAREN _3 = varRefBase _4 = EQUALS _5 = expr _6 = SEMICOLON _7 = expr _8 = SEMICOLON _9 = varRefBase _10 = EQUALS _11 = expr _12 = RPAREN _13 = genItemBlock
    {( QUINTUPLE (FOR, TRIPLE (ASSIGNMENT, _3, _5), _7, TRIPLE (ASSIGNMENT, _9, _11), _13) )}

genCaseListE:
  
    {( EMPTY )}
| _1 = genCaseList
    {( TLIST _1 )}

genCaseList:
  _1 = caseCondList _2 = COLON _3 = genItemBlock
    {( [ TRIPLE (GENCASECOND, TLIST _1, _3 ) ] )}
| _1 = DEFAULT _2 = COLON _3 = genItemBlock
    {( [ DOUBLE (DEFAULT, _3 ) ] )}
| _1 = DEFAULT _2 = genItemBlock
    {( [ DOUBLE (DEFAULT, _2 ) ] )}
| _1 = genCaseList _2 = caseCondList _3 = COLON _4 = genItemBlock
    {( TRIPLE (GENCASECOND, TLIST _2, _4) :: _1 )}
| _1 = genCaseList _2 = DEFAULT _3 = genItemBlock
    {( DOUBLE (DEFAULT, _3 ) :: _1 )}
| _1 = genCaseList _2 = DEFAULT _3 = COLON _4 = genItemBlock
