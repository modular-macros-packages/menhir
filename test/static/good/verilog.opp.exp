    {( TRIPLE (_1, _3 , _5 ) )}

instDecl:
  _1 = ID _2 = delayStrength _3 = instnameList _4 = SEMICOLON
    {(
if (Hashtbl.mem Globals.modprims (_1) == false) then
  begin
  if (List.mem _1 !Globals.unresolved_list == false) then begin
    Globals.unresolved_list := _1 :: !Globals.unresolved_list
    end
  end;
 QUADRUPLE (MODINST, (ID _1), _2, TLIST _3 )
)}
| _1 = ID _2 = delayStrength _3 = LPAREN _4 = varRefDotBit _5 = COMMA _6 = gateUdpPinList _7 = RPAREN _8 = SEMICOLON
    {(
if (Hashtbl.mem Globals.modprims (_1) == false) then
  begin
  if (List.mem _1 !Globals.unresolved_list == false) then begin
    Globals.unresolved_list := _1 :: !Globals.unresolved_list
    end
  end;
 QUADRUPLE (PRIMINST, (ID _1), _2, TLIST (_4::_6) )
)}

delayStrength:
  
    {( EMPTY )}
| _1 = HASH _2 = dlyTerm
    {( DOUBLE (HASH, _2 ) )}
| _1 = HASH _2 = LPAREN _3 = cellpinList _4 = RPAREN
