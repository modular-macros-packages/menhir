stmt:
  _1 = SEMICOLON
    {( EMPTY )}
| _1 = labeledStmt
    {( _1 )}
| _1 = identifier _2 = COLON _3 = labeledStmt
    {( DOUBLE (_1, _3 ) )}
| _1 = eventControl _2 = stmtBlock
    {( DOUBLE (_1, _2 ) )}
| _1 = varRefDotBit _2 = P_LTE _3 = delayE _4 = expr _5 = SEMICOLON
    {( QUADRUPLE (DLYASSIGNMENT, _1, _3, _4 ) )}
| _1 = varRefDotBit _2 = EQUALS _3 = delayE _4 = expr _5 = SEMICOLON
    {( QUADRUPLE ( ASSIGNMENT, _1, _3, _4 ) )}
| _1 = varRefDotBit _2 = EQUALS _3 = D_FOPEN _4 = LPAREN _5 = expr _6 = RPAREN _7 = SEMICOLON
    {( TRIPLE (D_FOPEN, _1, _5) )}
| _1 = ASSIGN _2 = varRefDotBit _3 = EQUALS _4 = delayStrength _5 = expr _6 = SEMICOLON
    {( QUADRUPLE (ASSIGN, _2, _4, _5 ) )}
| _1 = DEASSIGN _2 = varRefDotBit _3 = SEMICOLON
    {( DOUBLE (DEASSIGN, _2 ) )}
| _1 = LCURLY _2 = concIdList _3 = RCURLY _4 = P_LTE _5 = delayE _6 = expr _7 = SEMICOLON
    {( QUADRUPLE (DLYASSIGNMENT, DOUBLE (CONCAT,TLIST _2), _5, _6 ) )}
| _1 = LCURLY _2 = concIdList _3 = RCURLY _4 = EQUALS _5 = delayE _6 = expr _7 = SEMICOLON
    {( QUADRUPLE (ASSIGNMENT, DOUBLE (CONCAT,TLIST _2), _5, _6 ) )}
| _1 = D_C _2 = LPAREN _3 = cStrList _4 = RPAREN _5 = SEMICOLON
    {( TLIST _3 )}
| _1 = D_FCLOSE _2 = LPAREN _3 = varRefDotBit _4 = RPAREN _5 = SEMICOLON
    {( DOUBLE (D_FCLOSE, _3) )}
| _1 = D_FFLUSH _2 = SEMICOLON
    {( D_FFLUSH )}
| _1 = D_FFLUSH _2 = LPAREN _3 = RPAREN _4 = SEMICOLON
    {( D_FFLUSH )}
| _1 = D_FFLUSH _2 = LPAREN _3 = varRefDotBit _4 = RPAREN _5 = SEMICOLON
    {( DOUBLE (D_FFLUSH, _3) )}
| _1 = D_FINISH _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_FINISH, _2) )}
| _1 = D_FINISH _2 = LPAREN _3 = expr _4 = RPAREN _5 = SEMICOLON
    {( DOUBLE (D_FINISH, _3) )}
| _1 = D_STOP _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_STOP, _2 ) )}
| _1 = D_STOP _2 = LPAREN _3 = expr _4 = RPAREN _5 = SEMICOLON
    {( DOUBLE (D_STOP, _3 ) )}
| _1 = stateCaseForIf
    {( _1 )}
| _1 = taskRef _2 = SEMICOLON
    {( _1 )}
| _1 = D_DISPLAY _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_DISPLAY, _2 ) )}
| _1 = D_DISPLAY _2 = LPAREN _3 = ASCNUM _4 = commaEListE _5 = RPAREN _6 = SEMICOLON
    {( TRIPLE (D_DISPLAY, ASCNUM _3, _4); )}
| _1 = D_WRITE _2 = LPAREN _3 = ASCNUM _4 = commaEListE _5 = RPAREN _6 = SEMICOLON
    {( TRIPLE (D_WRITE,ASCNUM _3,_4) )}
| _1 = D_FDISPLAY _2 = LPAREN _3 = varRefDotBit _4 = monListE _5 = RPAREN _6 = SEMICOLON
    {( TRIPLE ( D_FDISPLAY, _3, _4 ) )}
| _1 = D_FWRITE _2 = LPAREN _3 = varRefDotBit _4 = monListE _5 = RPAREN _6 = SEMICOLON
    {( TRIPLE ( D_FWRITE, _3, _4 ) )}
| _1 = D_FWRITEH _2 = LPAREN _3 = varRefDotBit _4 = monListE _5 = RPAREN _6 = SEMICOLON
    {( TRIPLE ( D_FWRITEH, _3, _4 ) )}
| _1 = D_INFO _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_INFO, _2) )}
| _1 = D_INFO _2 = LPAREN _3 = ASCNUM _4 = commaEListE _5 = RPAREN _6 = SEMICOLON
    {( DOUBLE (D_INFO, _4) )}
| _1 = D_WARNING _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_WARNING, _2) )}
| _1 = D_WARNING _2 = LPAREN _3 = ASCNUM _4 = commaEListE _5 = RPAREN _6 = SEMICOLON
    {( DOUBLE (D_WARNING, _4) )}
| _1 = D_ERROR _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_ERROR, _2) )}
| _1 = D_ERROR _2 = LPAREN _3 = ASCNUM _4 = commaEListE _5 = RPAREN _6 = SEMICOLON
    {( DOUBLE (D_ERROR, _4) )}
| _1 = D_FATAL _2 = parenE _3 = SEMICOLON
    {( DOUBLE (D_FATAL, _2) )}
| _1 = D_FATAL _2 = LPAREN _3 = expr _4 = RPAREN _5 = SEMICOLON
    {( DOUBLE (D_FATAL, _3) )}
| _1 = D_FATAL _2 = LPAREN _3 = expr _4 = COMMA _5 = ASCNUM _6 = commaEListE _7 = RPAREN _8 = SEMICOLON
    {( TRIPLE ( D_FATAL, _3, _6 ) )}
| _1 = readmem _2 = LPAREN _3 = expr _4 = COMMA _5 = varRefMem _6 = RPAREN _7 = SEMICOLON
    {( TRIPLE ( D_READMEMB, _3, _5 ) )}
| _1 = readmem _2 = LPAREN _3 = expr _4 = COMMA _5 = varRefMem _6 = COMMA _7 = expr _8 = RPAREN _9 = SEMICOLON
    {( QUADRUPLE ( D_READMEMB, _3, _5, _7 ) )}
| _1 = readmem _2 = LPAREN _3 = expr _4 = COMMA _5 = varRefMem _6 = COMMA _7 = expr _8 = COMMA _9 = expr _10 = RPAREN _11 = SEMICOLON
    {( QUINTUPLE ( D_READMEMB, _3, _5, _7, _9 ) )}
| _1 = P_MINUSGT _2 = varRefDotBit _3 = SEMICOLON
