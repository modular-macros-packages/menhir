| _1 = DOT _2 = identifier _3 = LPAREN _4 = RPAREN
    {( DOUBLE (CELLPIN, _2 ) )}
| _1 = DOT _2 = identifier _3 = LPAREN _4 = expr _5 = RPAREN
    {( TRIPLE (CELLPIN, _2, _4) )}
| _1 = expr
    {( _1 )}

eventControl:
  _1 = AT _2 = LPAREN _3 = senList _4 = RPAREN
    {( DOUBLE ( AT, (TLIST _3 ) ) )}
| _1 = AT _2 = senitemVar
