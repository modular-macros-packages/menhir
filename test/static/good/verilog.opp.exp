    {( TRIPLE ( P_NAND, _1, _3 ) )}
| _1 = expr _2 = P_NOR _3 = expr
    {( TRIPLE ( P_NOR, _1, _3 ) )}
| _1 = expr _2 = CARET _3 = expr
    {( TRIPLE ( CARET, _1, _3 ) )}
| _1 = expr _2 = P_XNOR _3 = expr
    {( TRIPLE ( P_XNOR, _1, _3 ) )}
| _1 = expr _2 = P_EQUAL _3 = expr
    {( TRIPLE ( P_EQUAL, _1, _3 ) )}
| _1 = expr _2 = P_NOTEQUAL _3 = expr
    {( TRIPLE ( P_NOTEQUAL, _1, _3 ) )}
| _1 = expr _2 = P_CASEEQUAL _3 = expr
    {( TRIPLE ( P_CASEEQUAL, _1, _3 ) )}
| _1 = expr _2 = P_CASENOTEQUAL _3 = expr
    {( TRIPLE ( P_CASENOTEQUAL, _1, _3 ) )}
