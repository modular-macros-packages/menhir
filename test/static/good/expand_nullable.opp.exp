%start main
%token A
%token B
%token DECLARE
%token EOF
%type <(unit option * unit option) list> main
%%

declarations:
  
    {let _1 = ( [] ) in
( _1 )} [@name nil_declaration]
| _1 = nonempty_declarations
    {_1}

nonempty_option_A_:
  x = A
    {( Some x )} [@name some_A]

nonempty_option_B_:
  x = B
    {( Some x )} [@name some_B]

nonempty_list_declaration_:
  x = declaration
    {let xs = ( [] ) in
( x :: xs )} [@name cons_declaration_nil_declaration]
| x = declaration _1 = nonempty_list_declaration_
    {let xs = _1 in
( x :: xs )} [@name cons_declaration]

main:
  _1 = declarations _2 = EOF
    {( _1 )}

nonempty_declarations:
  _1 = nonempty_list_declaration_
    {( _1 )}

declaration:
  _1 = DECLARE
    {let _3 = ( None ) in
let _2 = ( None ) in
( _2, _3 )} [@name none_A_none_B]
| _1 = DECLARE _1_inlined1 = nonempty_option_B_
    {let _3 = _1_inlined1 in
let _2 = ( None ) in
( _2, _3 )} [@name none_A]
| _1 = DECLARE _1_inlined1 = nonempty_option_A_
    {let _3 = ( None ) in
let _2 = _1_inlined1 in
( _2, _3 )} [@name none_B]
| _1 = DECLARE _1_inlined1 = nonempty_option_A_ _1_inlined2 = nonempty_option_B_
    {let _3 = _1_inlined2 in
let _2 = _1_inlined1 in
( _2, _3 )}

%%
